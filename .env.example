# Optional overrides; defaults work without credentials. Export these in your shell.
WITNESS_DATA_DIR=data/local
WITNESS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WITNESS_ANALYSIS_MODE=mock
# Real mode setup and required credentials/weights: docs/integration.md
# WITNESS_MEDIA_ROOT=/absolute/path/to/approved-footage
# WITNESS_INCIDENT_PATH=/absolute/path/to/real-incident.json
# WITNESS_YOLO_WEIGHTS=/absolute/path/to/existing-weights.pt
# Cosmos connectivity only: docs/TASK-004B-SETUP.md
# COSMOS_BASE_URL=<documented deployment base ending in /v1; not /chat/completions>
# COSMOS_MODEL=<exact Reason 2 8B model ID from deployment docs or API>
# NVIDIA_API_KEY is read from the process environment; never put a real key here.
# COSMOS_API_KEY, when nonempty, overrides NVIDIA_API_KEY.
# WITNESS_PROVIDER_TIMEOUT=30
# WITNESS_PROVIDER_RETRIES=2
