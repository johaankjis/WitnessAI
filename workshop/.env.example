# Documentation only: the application does not load dotenv files.
WITNESS_WORKSHOP_MODE=fixture
HOST=127.0.0.1
PORT=8080
# On-cluster only: set mode=vast; URL is pinned by release.py.
# Inject only username/password via a Kubernetes Secret.
VSS_URL=http://video-backend-service.team-6.svc.cluster.local:8000
VSS_USERNAME=
VSS_PASSWORD=
VSS_TIMEOUT_SECONDS=60

# TASK-007: set only on the workshop VM / pod via runtime env or Secrets.
# Do not contact GPU services from the Mac. URLs are base URLs without endpoint paths.
WITNESS_LIVE_INFERENCE_ENABLED=false
COSMOS_GPU_URL=
YOLO_GPU_URL=
GPU_BEARER_TOKEN=
# Enabling also requires: kubectl exec <app-pod> -- python live_preflight.py
