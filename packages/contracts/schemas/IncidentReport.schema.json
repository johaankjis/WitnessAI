{
  "$defs": {
    "AtomicClaim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "statement_id": {
          "title": "Statement Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "category": {
          "enum": [
            "lane_change",
            "braking",
            "traffic_signal",
            "other"
          ],
          "title": "Category",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement_id",
        "text",
        "subject",
        "category"
      ],
      "title": "AtomicClaim",
      "type": "object"
    },
    "ClaimVerdict": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceWindow"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "uncertainty": {
          "minLength": 1,
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "verdict",
        "evidence",
        "explanation",
        "provenance",
        "uncertainty"
      ],
      "title": "ClaimVerdict",
      "type": "object"
    },
    "DetectorObservation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceWindow"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "id",
        "claim_id",
        "label",
        "evidence",
        "provenance"
      ],
      "title": "DetectorObservation",
      "type": "object"
    },
    "EvidenceWindow": {
      "additionalProperties": false,
      "properties": {
        "video_uri": {
          "title": "Video Uri",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "visibility": {
          "enum": [
            "visible",
            "not_visible"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "video_uri",
        "start_seconds",
        "end_seconds",
        "visibility",
        "description",
        "provenance"
      ],
      "title": "EvidenceWindow",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "is_mock": {
          "title": "Is Mock",
          "type": "boolean"
        }
      },
      "required": [
        "adapter",
        "version",
        "source",
        "is_mock"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "supported",
        "contradicted",
        "not_visible"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "is_mock": {
      "title": "Is Mock",
      "type": "boolean"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/AtomicClaim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "verdicts": {
      "items": {
        "$ref": "#/$defs/ClaimVerdict"
      },
      "minItems": 1,
      "title": "Verdicts",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/DetectorObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "human_review_required": {
      "const": true,
      "default": true,
      "title": "Human Review Required",
      "type": "boolean"
    },
    "legal_fault_determination": {
      "const": "not_provided",
      "default": "not_provided",
      "title": "Legal Fault Determination",
      "type": "string"
    }
  },
  "required": [
    "incident_id",
    "is_mock",
    "claims",
    "verdicts",
    "observations",
    "summary"
  ],
  "title": "IncidentReport",
  "type": "object"
}
